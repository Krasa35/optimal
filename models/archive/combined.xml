<mujoco model="ur_with_scene">
  <!-- Basic simulation options -->
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <!-- Import robot from URDF -->
  <include file="ur5e/robot.xml"/>

  <!-- Scene additions -->
  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <texture name="checker" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.1 0.1"/>
    <material name="floor_mat" texture="checker" texrepeat="4 4" reflectance="0.1"/>
  </asset>

  <worldbody>
    <!-- Ground -->
    <geom name="ground" type="plane" size="3 3 0.1" material="floor_mat" rgba="1 1 1 1"/>

    <!-- Light -->
    <light name="sun" pos="0 0 3" dir="0 0 -1" directional="true"/>

    <!-- A free box object -->
    <body name="box1" pos="0.5 0.0 0.2">
      <freejoint/>
      <geom type="box" size="0.04 0.04 0.04" mass="0.3" rgba="0.9 0.2 0.2 1"/>
    </body>

    <!-- A fixed sphere object -->
    <body name="ball_fixed" pos="-0.4 0.3 0.15">
      <geom type="sphere" size="0.06" rgba="0.2 0.2 0.9 1"/>
    </body>
  </worldbody>
</mujoco>